<div class="container mt-4">
  <!-- Shelter Details -->
  <h1 class="mb-3"><%= @shelter.name %></h1>
  <p class="text-muted mb-1"><strong>City:</strong> <%= @shelter.city %></p>
  <p class="text-muted mb-3"><strong>Email:</strong> <%= @shelter.email %></p>

  <hr class="my-4">

  <!-- Hierarchical Breeds List -->
  <h3 class="mb-3">Breeds Housed at this Shelter</h3>

  <% if @breeds.any? %>
    <div class="row">
      <% @breeds.each do |breed| %>
        <div class="col-md-4 mb-3">
          <div class="card h-100 shadow-sm">
            <% if breed.image_url.present? %>
              <img src="<%= breed.image_url %>" class="card-img-top" alt="<%= breed.name %>" style="height: 150px; object-fit: cover;">
            <% end %>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= breed.name %></h5>
              <p class="card-text text-muted small">Life Span: <%= breed.life_span %></p>
              <div class="mt-auto">
                <%= link_to "View Breed Details", breed_path(breed), class: "btn btn-outline-primary btn-sm w-100" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination for the shelter's breeds -->
    <div class="d-flex justify-content-center my-4">
      <%= paginate @breeds %>
    </div>
  <% else %>
    <p class="text-muted">No breeds currently listed for this shelter.</p>
  <% end %>

  <div class="mt-4">
    <%= link_to '← Back to Shelters', shelters_path, class: 'btn btn-secondary' %>
  </div>
</div>