<div class="container mt-4">
  <div class="mb-4">
    <h1><%= @shelter.name %></h1>
    <p class="text-muted mb-1"><strong>Location:</strong> <%= @shelter.city %></p>
    <p class="text-muted"><strong>Contact Email:</strong> <%= @shelter.email %></p>
    <%= link_to "Back to All Shelters", shelters_path, class: "btn btn-outline-secondary btn-sm mt-2" %>
  </div>

  <h3 class="mb-3">Breeds housed at this shelter:</h3>
  
  <div class="row">
    <% @breeds.each do |breed| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="<%= breed.image_url %>" class="card-img-top" alt="<%= breed.name %>" style="height: 220px; object-fit: cover;">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= breed.name %></h5>
            <p class="card-text text-muted mb-1"><strong>Life Span:</strong> <%= breed.life_span %></p>
            <div class="mt-auto">
              <%= link_to 'View Details', breed_path(breed), class: 'btn btn-primary btn-sm w-100' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center my-4">
    <%= paginate @breeds %>
  </div>
</div>