<div class="container mt-4">
  <h1 class="mb-4">Dog Breed Catalog</h1>

  <div class="row">
    <% @breeds.each do |breed| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="<%= breed.image_url %>" class="card-img-top" alt="<%= breed.name %>" style="height: 220px; object-fit: cover;">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= breed.name %></h5>
            <p class="card-text text-muted mb-1"><strong>Life Span:</strong> <%= breed.life_span %></p>
            <p class="card-text"><small class="text-secondary"><strong>Shelter:</strong> <%= breed.shelter.name %></small></p>
            <div class="mt-auto">
              <%= link_to 'View Details', breed_path(breed), class: 'btn btn-primary btn-sm w-100' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center my-4">
    <%= paginate @breeds %>
  </div>
</div>