<div class="container mt-4">
  <h1 class="mb-4">Dog Breed Catalog</h1>
  <div class="row">
    <% @breeds.each do |breed| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="<%= breed.image_url %>" class="card-img-top" alt="<%= breed.name %>" style="height: 220px; object-fit: cover;">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= link_to breed.name, breed_path(breed), class: "text-decoration-none" %></h5>
            <p class="card-text text-muted mb-4">Rescue: <%= link_to breed.shelter.name, shelter_path(breed.shelter), class: "text-decoration-none" %></p>
            <%= link_to 'View Details', breed_path(breed), class: 'mt-auto btn btn-outline-primary btn-sm' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>