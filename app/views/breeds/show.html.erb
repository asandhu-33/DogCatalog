<div class="container mt-4">
  <div class="row">
    <div class="col-md-6">
      <img src="<%= @breed.image_url %>" class="img-fluid rounded shadow" alt="<%= @breed.name %>" style="max-height: 400px; width: 100%; object-fit: cover;">
    </div>
    <div class="col-md-6">
      <h1><%= @breed.name %></h1>
      <p><strong>Life Span:</strong> <%= @breed.life_span %></p>
      
      <hr>
      
      <h3>Associated Shelter</h3>
      <div class="card p-3 bg-light mb-3">
        <p class="mb-1"><strong>Name:</strong> <%= link_to @breed.shelter.name, shelter_path(@breed.shelter) %></p>
        <p class="mb-1"><strong>City:</strong> <%= @breed.shelter.city %></p>
        <p class="mb-0"><strong>Email:</strong> <%= @breed.shelter.email %></p>
      </div>

      <%= link_to '← Back to All Breeds', breeds_path, class: 'btn btn-secondary' %>
    </div>
  </div>
</div>