<div class="container mt-4">
  <div class="row">
    <!-- Breed Image Column -->
    <div class="col-md-5 mb-4">
      <div class="card shadow-sm">
        <img src="<%= @breed.image_url %>" class="card-img-top" alt="<%= @breed.name %>" style="height: 350px; object-fit: cover;">
      </div>
    </div>

    <!-- Breed & Shelter Details Column -->
    <div class="col-md-7">
      <h1 class="mb-3"><%= @breed.name %></h1>
      
      <div class="card shadow-sm p-4 mb-4 bg-light">
        <h4 class="mb-3">Breed Information</h4>
        <p><strong>Life Span:</strong> <%= @breed.life_span %></p>
      </div>

      <div class="card shadow-sm p-4 mb-4">
        <h4 class="mb-3">Shelter Information</h4>
        <p><strong>Shelter Name:</strong> <%= @breed.shelter.name %></p>
        <p><strong>City:</strong> <%= @breed.shelter.city %></p>
        <p><strong>Contact Email:</strong> <%= @breed.shelter.email %></p>
      </div>

      <div class="d-flex gap-2">
        <%= link_to 'Back to Catalog', breeds_path, class: 'btn btn-outline-secondary' %>
      </div>
    </div>
  </div>
</div>